# Copy this file to .env, then replace the placeholder values.
# .env is ignored by Git and must never be committed or shared.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_sb_secret_key
SUPABASE_BUCKET=album-photos
# Optional: only used by the Netlify image-upload function.
EDIT_CODE=your_site_editor_password
