  <script>
    const defaults = {
      code: "20260526",
      editCode: "20260610",
      startDate: "2026-05-26",
      startTime: "23:29:00",
      edits: {},
      editTimes: {},
      wishes: [
        { text: "一起看一次海边日出", done: false, updatedAt: "" },
        { text: "拍一组只属于我们的照片", done: false, updatedAt: "" },
        { text: "把喜欢的城市慢慢走完", done: false, updatedAt: "" }
      ],
      photos: ["", "", ""],
      photoPositions: [
        { x: 50, y: 50 },
        { x: 50, y: 50 },
        { x: 50, y: 50 }
      ],
      customItems: {
        story: [],
        daily: [],
        notes: [],
        travel: [],
        album: []
      }
    };
    const addConfig = {
      story: {
        fields: ["time", "title", "text"],
        defaults: { time: "新的片段", title: "新的故事", text: "写下这个瞬间。" },
        submit: "新增故事"
      },
      daily: {
        fields: ["label", "title", "text"],
        defaults: { label: "Daily", title: "新的日常", text: "写下今天的小事。" },
        submit: "新增日常"
      },
      notes: {
        fields: ["time", "text"],
        defaults: { time: "今天", text: "写下此刻想说的话。" },
        submit: "新增碎碎念"
      },
      travel: {
        fields: ["label", "title", "text"],
        defaults: { label: "下一站", title: "新的地点", text: "写下这段旅行。" },
        submit: "新增旅行"
      },
      album: {
        fields: ["caption", "content", "photo"],
        defaults: { caption: "新的照片", content: "写下这张照片背后的故事。", photo: "" },
        submit: "新增照片"
      }
    };
    let memoryAuth = false;
    let memoryEditAuth = false;
    let memorySite = null;
    const state = load();
    const editDefaults = {};
    let activeModule = null;

    const loginScreen = document.querySelector("#loginScreen");
    const appScreen = document.querySelector("#appScreen");
    const homeMusic = document.querySelector("#homeMusic");
    const editor = document.querySelector("#editor");
    const editorFields = document.querySelector("#editorFields");
    const editorMeta = document.querySelector("#editorMeta");

    document.querySelectorAll("[data-edit]").forEach((el) => {
      editDefaults[el.dataset.edit] = el.innerHTML.trim();
    });

    init();

    function init() {
      applyEdits();
      initLogin();
      initNav();
      initTimer();
      initSettings();
      keepAddControlsAtBottom();
      initAddForms();
      renderCustomItems();
      initModuleButtons();
      initEditor();
      initWishes();
      initPhotos();
      updateEditAccess();
      setInterval(updateTimer, 1000);
      if (getAuth()) showApp();
    }

    function load() {
      const fallback = memorySite || {};
      try {
        return normalizeState({ ...defaults, ...JSON.parse(localStorage.getItem("dt-mobile-site") || "{}") });
      } catch {
        return normalizeState({ ...defaults, ...fallback });
      }
    }

    function normalizeState(value) {
      const next = value && typeof value === "object" ? value : {};
      return {
        ...defaults,
        ...next,
        wishes: Array.isArray(next.wishes) ? next.wishes : defaults.wishes,
        photos: Array.isArray(next.photos) ? next.photos.concat(defaults.photos).slice(0, 3) : defaults.photos,
        photoPositions: normalizePhotoPositions(next.photoPositions),
        customItems: normalizeCustomItems(next.customItems)
      };
    }

    function normalizePhotoPositions(value) {
      const positions = Array.isArray(value) ? value : [];
      return defaults.photoPositions.map((position, index) => normalizePhotoPosition(positions[index] || position));
    }

    function normalizePhotoPosition(value) {
      const source = value && typeof value === "object" ? value : {};
      return {
        x: clampPercent(source.x),
        y: clampPercent(source.y)
      };
    }

    function clampPercent(value) {
      const number = Number(value);
      if (!Number.isFinite(number)) return 50;
      return Math.max(0, Math.min(100, number));
    }

    function normalizeCustomItems(value) {
      const source = value && typeof value === "object" ? value : {};
      return Object.fromEntries(Object.keys(defaults.customItems).map((type) => {
        const entries = Array.isArray(source[type]) ? source[type] : [];
        return [type, entries.map((entry) => normalizeCustomItem(type, entry)).filter(Boolean)];
      }));
    }

    function normalizeCustomItem(type, entry) {
      if (!entry || typeof entry !== "object") return null;
      const config = addConfig[type];
      const item = {
        id: String(entry.id || `${type}-${Date.now()}-${Math.random().toString(36).slice(2)}`),
        updatedAt: entry.updatedAt || ""
      };

      config.fields.forEach((field) => {
        item[field] = String(entry[field] || "").trim();
      });

      if (type === "album") {
        item.position = normalizePhotoPosition(entry.position);
        return item.photo ? item : null;
      }
      return item.text || item.title ? item : null;
    }

    function save() {
      memorySite = JSON.parse(JSON.stringify(state));
      try {
        localStorage.setItem("dt-mobile-site", JSON.stringify(state));
      } catch {
        // Some mobile browsers block storage for local HTML files.
      }
    }

    function getAuth() {
      try {
        return sessionStorage.getItem("dt-mobile-auth") === "yes";
      } catch {
        return memoryAuth;
      }
    }

    function setAuth(value) {
      memoryAuth = !!value;
      try {
        if (value) {
          sessionStorage.setItem("dt-mobile-auth", "yes");
        } else {
          sessionStorage.removeItem("dt-mobile-auth");
        }
      } catch {
        // Keep the in-memory value when browser storage is blocked.
      }
      if (!value) setEditAuth(false);
    }

    function getEditAuth() {
      try {
        return sessionStorage.getItem("dt-mobile-edit-auth") === "yes";
      } catch {
        return memoryEditAuth;
      }
    }

    function setEditAuth(value) {
      memoryEditAuth = !!value;
      try {
        if (value) {
          sessionStorage.setItem("dt-mobile-edit-auth", "yes");
        } else {
          sessionStorage.removeItem("dt-mobile-edit-auth");
        }
      } catch {
        // Keep the in-memory value when browser storage is blocked.
      }
      updateEditAccess();
    }

    function initLogin() {
      const form = document.querySelector("#loginForm");
      const submitLogin = (event) => {
        event.preventDefault();
        const code = document.querySelector("#loginCode").value.trim();
        if (code !== defaults.code) {
          document.querySelector("#loginError").textContent = "暗号不对，再试一次。";
          return;
        }
        setAuth(true);
        showApp();
      };
      form.addEventListener("submit", submitLogin);
      document.querySelector("#loginButton").addEventListener("click", submitLogin);
      document.querySelector("#loginCode").addEventListener("keydown", (event) => {
        if (event.key === "Enter") submitLogin(event);
      });
    }

    function showApp() {
      loginScreen.classList.remove("active");
      appScreen.classList.add("active");
      const hashPage = normalizePage(location.hash.replace("#", ""));
      const activePage = hashPage || "home";
      if (hashPage) showPage(hashPage, false);
      syncHomeMusic(activePage);
      if (activePage === "home") bindHomeMusicRetry();
      updateEditAccess();
      updateTimer();
    }

    function toggleEditAuth() {
      if (getEditAuth()) {
        setEditAuth(false);
        closeEditor();
        return;
      }

      const code = prompt("请输入编辑暗号");
      if (code === null) return;
      if (code.trim() === defaults.editCode) {
        setEditAuth(true);
      } else {
        alert("编辑暗号不对。");
      }
    }

    function updateEditAccess() {
      const unlocked = getEditAuth();
      document.body.classList.toggle("edit-unlocked", unlocked);
      document.querySelectorAll("[data-edit-auth]").forEach((button) => {
        button.classList.toggle("edit-unlocked", unlocked);
        button.textContent = unlocked ? "关闭编辑" : "编辑";
      });
    }

    function initNav() {
      const nav = document.querySelector("#nav");
      if (!nav) return;
      nav.addEventListener("click", (event) => {
        const btn = event.target.closest("button");
        if (!btn) return;
        if (btn.hasAttribute("data-edit-auth")) {
          toggleEditAuth();
          return;
        }
        if (btn.hasAttribute("data-logout")) {
          setAuth(false);
          appScreen.classList.remove("active");
          loginScreen.classList.add("active");
          return;
        }
        if (btn.dataset.page) showPage(btn.dataset.page);
      });
      document.querySelectorAll("[data-go]").forEach((card) => {
        card.addEventListener("click", (event) => {
          if (event.target.closest(".module-edit")) return;
          event.preventDefault();
          showPage(card.dataset.go);
        });
      });
    }

    function showPage(page, updateHash = true) {
      page = normalizePage(page);
      if (!page) return;
      document.querySelectorAll("[data-page-view]").forEach((view) => view.classList.toggle("active", view.dataset.pageView === page));
      document.querySelectorAll("#nav [data-page]").forEach((btn) => btn.classList.toggle("active", btn.dataset.page === page));
      window.scrollTo({ top: 0, behavior: "smooth" });
      if (updateHash) history.replaceState(null, "", `#${page}`);
      syncHomeMusic(page);
      closeEditor();
    }

    function syncHomeMusic(page) {
      if (!homeMusic) return;
      homeMusic.loop = true;
      homeMusic.preload = "auto";
      if (page === "home") {
        const play = homeMusic.play();
        if (play && typeof play.catch === "function") play.catch(() => {});
      } else {
        homeMusic.pause();
      }
    }

    function bindHomeMusicRetry() {
      if (!homeMusic || homeMusic.dataset.retryBound === "yes") return;
      homeMusic.dataset.retryBound = "yes";
      const retry = () => syncHomeMusic("home");
      ["pointerdown", "touchstart", "keydown"].forEach((eventName) => {
        window.addEventListener(eventName, retry, { once: true, passive: true });
      });
    }

    function normalizePage(value) {
      const pages = ["home", "story", "daily", "notes", "travel", "album", "wishes"];
      return pages.includes(value) ? value : "";
    }

    function initTimer() {
      document.querySelector("#startDate").value = state.startDate || defaults.startDate;
      document.querySelector("#startTime").value = state.startTime || defaults.startTime;
      updateTimer();
    }

    function updateTimer() {
      const start = new Date(`${state.startDate || defaults.startDate}T${state.startTime || defaults.startTime}`);
      const diff = Math.max(0, Date.now() - start.getTime());
      const total = Math.floor(diff / 1000);
      document.querySelector("#daysTogether").textContent = Math.floor(total / 86400);
      document.querySelector("#hoursTogether").textContent = String(Math.floor((total % 86400) / 3600)).padStart(2, "0");
      document.querySelector("#minutesTogether").textContent = String(Math.floor((total % 3600) / 60)).padStart(2, "0");
      document.querySelector("#secondsTogether").textContent = String(total % 60).padStart(2, "0");
    }

    function initSettings() {
      document.querySelector("#settingsForm").addEventListener("submit", (event) => {
        event.preventDefault();
        state.startDate = document.querySelector("#startDate").value || defaults.startDate;
        state.startTime = document.querySelector("#startTime").value || defaults.startTime;
        save();
        updateTimer();
      });
    }

    function initModuleButtons() {
      document.querySelectorAll(".card, .hero-copy, .photo-card, .map").forEach((scope) => {
        if (scope.classList.contains("gateway-card")) return;
        if (!scope.querySelector("[data-edit]") && !scope.matches("[data-edit]")) return;
        if (Array.from(scope.children).some((child) => child.classList && child.classList.contains("module-edit"))) return;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "module-edit";
        btn.textContent = "编辑";
        btn.addEventListener("click", (event) => {
          event.stopPropagation();
          if (!getEditAuth()) return;
          openEditor(scope);
        });
        const time = document.createElement("small");
        time.className = "edit-time";
        scope.append(btn, time);
      });
      refreshEditTimes();
    }

    function initEditor() {
      document.querySelector("#editorClose").addEventListener("click", closeEditor);
      document.querySelector("#editorReset").addEventListener("click", () => {
        if (!activeModule) return;
        getFields(activeModule).forEach((field) => delete state.edits[field.dataset.edit]);
        delete state.editTimes[getModuleId(activeModule)];
        save();
        applyEdits();
        openEditor(activeModule);
      });
      document.querySelector("#editorSave").addEventListener("click", () => {
        if (!activeModule) return;
        editorFields.querySelectorAll("[data-field]").forEach((textarea) => {
          state.edits[textarea.dataset.field] = sanitize(textarea.value.trim());
        });
        state.editTimes[getModuleId(activeModule)] = Date.now();
        save();
        applyEdits();
        openEditor(activeModule);
      });
    }

    function openEditor(scope) {
      activeModule = scope;
      const fields = getFields(scope);
      editorFields.innerHTML = fields.map((field, index) => {
        const key = field.dataset.edit;
        const value = state.edits[key] ?? editDefaults[key] ?? field.innerHTML.trim();
        return `<label><span>内容 ${index + 1}</span><textarea data-field="${escapeAttr(key)}">${escapeHtml(value)}</textarea></label>`;
      }).join("");
      const updatedAt = state.editTimes[getModuleId(scope)];
      editorMeta.textContent = updatedAt ? `编辑时间：${formatTime(updatedAt)}` : "";
      editor.classList.add("open");
      editorFields.querySelector("textarea")?.focus();
    }

    function closeEditor() {
      editor.classList.remove("open");
      activeModule = null;
    }

    function getFields(scope) {
      const fields = scope.matches("[data-edit]") ? [scope] : Array.from(scope.querySelectorAll("[data-edit]"));
      return fields.filter((item, index, all) => all.findIndex((other) => other.dataset.edit === item.dataset.edit) === index);
    }

    function getModuleId(scope) {
      return getFields(scope).map((field) => field.dataset.edit).sort().join("|");
    }

    function applyEdits() {
      document.querySelectorAll("[data-edit]").forEach((el) => {
        const html = state.edits[el.dataset.edit] ?? editDefaults[el.dataset.edit] ?? el.innerHTML;
        el.innerHTML = sanitize(html);
      });
      refreshEditTimes();
    }

    function refreshEditTimes() {
      document.querySelectorAll(".card, .hero-copy, .photo-card, .map").forEach((scope) => {
        if (scope.classList.contains("gateway-card")) return;
        const time = Array.from(scope.children).find((child) => child.classList && child.classList.contains("edit-time"));
        if (!time) return;
        const value = state.editTimes[getModuleId(scope)];
        time.textContent = value ? `编辑时间：${formatTime(value)}` : "";
      });
    }

    function initAddForms() {
      document.querySelectorAll("[data-add-form]").forEach((form) => {
        const type = form.dataset.addForm;
        const config = addConfig[type];
        if (!config) return;

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!getEditAuth()) {
            setAddMessage(form, "请先点击顶部“编辑”并输入编辑暗号。");
            return;
          }

          const entry = await readAddForm(type, form);
          if (!entry) {
            setAddMessage(form, type === "album" ? "请先上传一张照片。" : "先写一点内容再保存。");
            return;
          }

          const editingId = form.dataset.editingId;
          const entries = state.customItems[type] || [];
          const hasNewPhoto = type === "album" && Boolean(form.elements.photo?.files?.[0]);
          if (editingId) {
            const index = entries.findIndex((item) => item.id === editingId);
            if (index >= 0) {
              entries[index] = { ...entries[index], ...entry, id: editingId, updatedAt: Date.now() };
            } else {
              entries.unshift({ ...entry, updatedAt: Date.now() });
            }
          } else {
            entries.unshift({ ...entry, updatedAt: Date.now() });
          }

          state.customItems[type] = entries;
          resetAddForm(type, form);
          renderCustomItems(type);
          save();
          setAddMessage(form, editingId ? "已保存修改。" : "已新增。");
          if (hasNewPhoto && entry.photo) openCustomPhotoPositionEditor(entry.id);
        });

        form.querySelector("[data-add-cancel]")?.addEventListener("click", () => {
          resetAddForm(type, form);
          setAddMessage(form, "");
        });
      });
    }

    async function readAddForm(type, form) {
      const config = addConfig[type];
      const editingId = form.dataset.editingId;
      const existing = editingId ? (state.customItems[type] || []).find((item) => item.id === editingId) : null;
      const entry = {
        id: editingId || `${type}-${Date.now()}-${Math.random().toString(36).slice(2)}`
      };

      if (type === "album") {
        const caption = sanitize(String(form.elements.caption?.value || "").trim());
        const content = sanitize(String(form.elements.content?.value || "").trim());
        const file = form.elements.photo?.files?.[0];
        entry.caption = caption || existing?.caption || addConfig.album.defaults.caption;
        entry.content = content;
        entry.photo = existing?.photo || "";
        if (file) entry.photo = await readFileAsDataUrl(file);
        if (!entry.photo) return null;
        entry.position = file ? normalizePhotoPosition() : normalizePhotoPosition(existing?.position);
        return entry.caption || entry.content || entry.photo ? entry : null;
      }

      config.fields.forEach((field) => {
        entry[field] = sanitize(String(form.elements[field]?.value || "").trim());
      });

      if (type === "story" && !entry.time) entry.time = existing?.time || "";

      return entry.text || entry.title ? entry : null;
    }

    function resetAddForm(type, form = document.querySelector(`[data-add-form="${type}"]`)) {
      if (!form) return;
      form.reset();
      delete form.dataset.editingId;
      form.querySelector("[data-add-cancel]")?.setAttribute("hidden", "");
      form.querySelector('button[type="submit"]')?.replaceChildren(document.createTextNode(addConfig[type].submit));
    }

    function setAddMessage(form, message) {
      const target = form?.querySelector("[data-add-message]");
      if (target) target.textContent = message;
    }

    function keepAddControlsAtBottom() {
      Object.keys(addConfig).forEach((type) => {
        const form = document.querySelector(`[data-add-form="${type}"]`);
        const list = document.querySelector(`[data-custom-list="${type}"]`);
        const section = list?.closest(".page");
        if (!form || !list || !section) return;

        const defaultList = Array.from(section.children).find((child) => {
          if (child === form || child === list) return false;
          return (child.classList.contains("grid") || child.classList.contains("photo-grid")) && !child.classList.contains("custom-list");
        });
        if (defaultList && defaultList.previousElementSibling !== list) {
          defaultList.insertAdjacentElement("beforebegin", list);
        }
        if (section.lastElementChild !== form) {
          section.appendChild(form);
        }
      });

      const wishForm = document.querySelector("#wishForm");
      const wishList = document.querySelector("#wishList");
      if (wishForm && wishList && wishList.nextElementSibling !== wishForm) {
        wishList.insertAdjacentElement("afterend", wishForm);
      }
    }

    function latestFirstEntries(entries) {
      return (Array.isArray(entries) ? entries : [])
        .map((entry, index) => ({ entry, index, time: Number(entry?.updatedAt) || getTimeFromId(entry?.id) }))
        .sort((a, b) => b.time - a.time || a.index - b.index);
    }

    function chronologicalStoryEntries(entries) {
      return (Array.isArray(entries) ? entries : [])
        .map((entry, index) => {
          const date = new Date(`${String(entry?.time || "").trim()}T00:00:00`);
          const time = date.getTime();
          return {
            entry,
            index,
            hasDate: !Number.isNaN(time),
            time: Number.isNaN(time) ? Number(entry?.updatedAt) || getTimeFromId(entry?.id) : time
          };
        })
        .sort((a, b) => {
          if (a.hasDate !== b.hasDate) return a.hasDate ? -1 : 1;
          return a.time - b.time || a.index - b.index;
        });
    }

    function getTimeFromId(id) {
      const match = String(id || "").match(/-(\d{11,})-/);
      return match ? Number(match[1]) : 0;
    }

    function renderCustomItems(targetType) {
      Object.keys(addConfig).forEach((type) => {
        if (targetType && targetType !== type) return;
        const list = document.querySelector(`[data-custom-list="${type}"]`);
        if (!list) return;

        list.innerHTML = "";
        const entries = type === "story"
          ? chronologicalStoryEntries(state.customItems[type])
          : latestFirstEntries(state.customItems[type]);
        entries.forEach(({ entry }) => {
          list.appendChild(createCustomCard(type, entry));
        });
      });
    }

    function createCustomCard(type, entry) {
      const card = document.createElement("article");
      const updatedAt = entry.updatedAt ? `编辑时间：${formatTime(entry.updatedAt)}` : "";

      if (type === "album") {
        card.className = entry.photo ? "photo-card dynamic-photo-card has-image" : "photo-card dynamic-photo-card";
        const position = normalizePhotoPosition(entry.position);
        card.innerHTML = `
          <img src="${escapeAttr(entry.photo || "")}" alt="新增照片" style="object-position: ${position.x}% ${position.y}%;">
          <span><b>${sanitize(entry.caption || addConfig.album.defaults.caption)}</b><em>${sanitize(entry.content || "")}</em></span>
          <button class="module-delete" type="button">删除</button>
          <button class="module-edit" type="button">编辑</button>
          <button class="module-position" type="button">展示区域</button>
          <small class="edit-time">${updatedAt}</small>
        `;
      } else {
        card.className = "card custom-card";
        if (type === "story") {
          card.innerHTML = `
            <time>${sanitize(entry.time || addConfig.story.defaults.time)}</time>
            <h3>${sanitize(entry.title || addConfig.story.defaults.title)}</h3>
            <p>${sanitize(entry.text || addConfig.story.defaults.text)}</p>
            <button class="module-delete" type="button">删除</button>
            <button class="module-edit" type="button">编辑</button>
            <small class="edit-time">${updatedAt}</small>
          `;
        } else if (type === "notes") {
          card.innerHTML = `
            <time>${sanitize(entry.time || addConfig.notes.defaults.time)}</time>
            <p>${sanitize(entry.text || addConfig.notes.defaults.text)}</p>
            <button class="module-delete" type="button">删除</button>
            <button class="module-edit" type="button">编辑</button>
            <small class="edit-time">${updatedAt}</small>
          `;
        } else {
          const config = addConfig[type];
          card.innerHTML = `
            <span>${sanitize(entry.label || config.defaults.label)}</span>
            <h3>${sanitize(entry.title || config.defaults.title)}</h3>
            <p>${sanitize(entry.text || config.defaults.text)}</p>
            <button class="module-delete" type="button">删除</button>
            <button class="module-edit" type="button">编辑</button>
            <small class="edit-time">${updatedAt}</small>
          `;
        }
      }

      card.querySelector(".module-edit").addEventListener("click", (event) => {
        event.stopPropagation();
        editCustomItem(type, entry.id);
      });
      card.querySelector(".module-position")?.addEventListener("click", (event) => {
        event.stopPropagation();
        openCustomPhotoPositionEditor(entry.id);
      });
      card.querySelector(".module-delete").addEventListener("click", (event) => {
        event.stopPropagation();
        if (!confirm("确定删除这一条吗？")) return;
        state.customItems[type] = (state.customItems[type] || []).filter((item) => item.id !== entry.id);
        renderCustomItems(type);
        save();
      });
      if (type === "album" && entry.photo) {
        card.addEventListener("click", (event) => {
          if (event.target.closest("button")) return;
          openPhotoPreview(entry.photo, entry.caption, entry.content);
        });
      }

      return card;
    }

    function editCustomItem(type, id) {
      if (!getEditAuth()) return;
      const form = document.querySelector(`[data-add-form="${type}"]`);
      const entry = (state.customItems[type] || []).find((item) => item.id === id);
      if (!form || !entry) return;

      form.dataset.editingId = id;
      Object.keys(entry).forEach((key) => {
        if (key === "photo" || key === "id" || key === "updatedAt") return;
        if (form.elements[key]) form.elements[key].value = entry[key] || "";
      });
      form.querySelector("[data-add-cancel]")?.removeAttribute("hidden");
      form.querySelector('button[type="submit"]')?.replaceChildren(document.createTextNode("保存修改"));
      setAddMessage(form, "正在编辑，保存后覆盖这一条。");
      form.scrollIntoView({ behavior: "smooth", block: "center" });
      form.querySelector("input, textarea")?.focus();
    }

    function readFileAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.addEventListener("load", () => resolve(reader.result));
        reader.addEventListener("error", reject);
        reader.readAsDataURL(file);
      });
    }

    function initWishes() {
      const form = document.querySelector("#wishForm");
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!getEditAuth()) return;
        const input = document.querySelector("#wishInput");
        if (!input.value.trim()) return;
        state.wishes.unshift({ text: sanitize(input.value.trim()), done: false, updatedAt: Date.now() });
        input.value = "";
        save();
        renderWishes();
      });
      renderWishes();
    }

    function renderWishes() {
      const list = document.querySelector("#wishList");
      list.innerHTML = "";
      latestFirstEntries(state.wishes).forEach(({ entry: wish, index }) => {
        const li = document.createElement("li");
        li.className = wish.done ? "done" : "";
        li.innerHTML = `
          <button class="check" type="button">${wish.done ? "✓" : "○"}</button>
          <span><span class="wish-text">${sanitize(wish.text)}</span><small class="wish-meta">${wish.updatedAt ? `编辑时间：${formatTime(wish.updatedAt)}` : ""}</small></span>
          <button class="remove" type="button">×</button>
        `;
        li.querySelector(".check").addEventListener("click", () => {
          if (!getEditAuth()) return;
          wish.done = !wish.done;
          wish.updatedAt = Date.now();
          save();
          renderWishes();
        });
        li.querySelector(".remove").addEventListener("click", () => {
          if (!getEditAuth()) return;
          state.wishes.splice(index, 1);
          save();
          renderWishes();
        });
        li.querySelector(".wish-text").addEventListener("click", () => {
          if (!getEditAuth()) return;
          const next = prompt("编辑愿望", wish.text);
          if (next === null) return;
          wish.text = sanitize(next);
          wish.updatedAt = Date.now();
          save();
          renderWishes();
        });
        list.appendChild(li);
      });
    }

    function initPhotos() {
      state.photos = Array.isArray(state.photos) ? state.photos.concat(["", "", ""]).slice(0, 3) : ["", "", ""];
      document.querySelectorAll("[data-photo-preview]").forEach((img) => {
        const index = Number(img.dataset.photoPreview);
        if (state.photos[index]) {
          img.src = state.photos[index];
          const position = normalizePhotoPosition(state.photoPositions[index]);
          img.style.objectPosition = `${position.x}% ${position.y}%`;
          img.closest(".photo-card").classList.add("has-image");
        }
      });
      document.querySelectorAll("[data-photo]").forEach((input) => {
        const card = input.closest(".photo-card");
        if (card && !card.querySelector("[data-fixed-photo-position]")) {
          const button = document.createElement("button");
          button.className = "photo-position-button";
          button.type = "button";
          button.dataset.fixedPhotoPosition = input.dataset.photo;
          button.textContent = "展示区域";
          button.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();
            openFixedPhotoPositionEditor(Number(input.dataset.photo));
          });
          card.appendChild(button);
        }

        input.addEventListener("change", () => {
          const file = input.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = () => {
            const index = Number(input.dataset.photo);
            state.photos[index] = reader.result;
            state.photoPositions[index] = normalizePhotoPosition(state.photoPositions[index]);
            save();
            const img = document.querySelector(`[data-photo-preview="${index}"]`);
            img.src = reader.result;
            const position = normalizePhotoPosition(state.photoPositions[index]);
            img.style.objectPosition = `${position.x}% ${position.y}%`;
            img.closest(".photo-card").classList.add("has-image");
            openFixedPhotoPositionEditor(index);
          };
          reader.readAsDataURL(file);
        });
        card?.addEventListener("click", (event) => {
          if (getEditAuth() || event.target.closest("button") || !card.classList.contains("has-image")) return;
          event.preventDefault();
          const index = Number(input.dataset.photo);
          const caption = card.querySelector("[data-edit]")?.textContent || "";
          openPhotoPreview(state.photos[index], caption, "");
        });
      });
    }

    function openPhotoPreview(src, title = "", content = "") {
      if (!src) return;
      const modal = document.createElement("div");
      modal.className = "photo-preview-modal";
      modal.innerHTML = `
        <div class="photo-preview-panel" role="dialog" aria-modal="true" aria-label="照片预览">
          <img src="${escapeAttr(src)}" alt="${escapeAttr(title || "照片预览")}">
          <div class="photo-preview-caption">
            <strong>${escapeHtml(title || "回忆照片")}</strong>
            <span>${escapeHtml(content || "")}</span>
          </div>
        </div>
      `;
      const onKey = (event) => {
        if (event.key === "Escape") close();
      };
      const close = () => {
        modal.remove();
        document.removeEventListener("keydown", onKey);
      };
      modal.addEventListener("click", close);
      modal.querySelector(".photo-preview-panel").addEventListener("click", (event) => event.stopPropagation());
      document.addEventListener("keydown", onKey);
      document.body.appendChild(modal);
    }

    function openFixedPhotoPositionEditor(index) {
      if (!state.photos[index]) return;
      openPhotoPositionEditor({
        title: "选择展示区域",
        src: state.photos[index],
        position: state.photoPositions[index],
        onSave: (position) => {
          state.photoPositions[index] = normalizePhotoPosition(position);
          save();
          const img = document.querySelector(`[data-photo-preview="${index}"]`);
          if (img) img.style.objectPosition = `${state.photoPositions[index].x}% ${state.photoPositions[index].y}%`;
        }
      });
    }

    function openCustomPhotoPositionEditor(id) {
      const entry = (state.customItems.album || []).find((item) => item.id === id);
      if (!entry?.photo) return;
      openPhotoPositionEditor({
        title: "选择展示区域",
        src: entry.photo,
        position: entry.position,
        onSave: (position) => {
          entry.position = normalizePhotoPosition(position);
          entry.updatedAt = Date.now();
          save();
          renderCustomItems("album");
        }
      });
    }

    function openPhotoPositionEditor({ title, src, position, onSave }) {
      const current = normalizePhotoPosition(position);
      const modal = document.createElement("div");
      modal.className = "photo-position-modal";
      modal.innerHTML = `
        <div class="photo-position-panel" role="dialog" aria-modal="true" aria-label="${escapeAttr(title)}">
          <div class="photo-position-head">
            <strong>${escapeHtml(title)}</strong>
            <button type="button" data-photo-position-close>关闭</button>
          </div>
          <div class="photo-position-preview">
            <img src="${escapeAttr(src)}" alt="照片展示区域预览">
          </div>
          <label class="photo-position-range">
            <span>左右</span>
            <input type="range" min="0" max="100" value="${current.x}" data-photo-position-x>
          </label>
          <label class="photo-position-range">
            <span>上下</span>
            <input type="range" min="0" max="100" value="${current.y}" data-photo-position-y>
          </label>
          <div class="photo-position-actions">
            <button type="button" data-photo-position-close>取消</button>
            <button type="button" data-photo-position-save>保存展示区域</button>
          </div>
        </div>
      `;

      const image = modal.querySelector("img");
      const xInput = modal.querySelector("[data-photo-position-x]");
      const yInput = modal.querySelector("[data-photo-position-y]");
      const apply = () => {
        image.style.objectPosition = `${xInput.value}% ${yInput.value}%`;
      };
      const close = () => modal.remove();

      xInput.addEventListener("input", apply);
      yInput.addEventListener("input", apply);
      modal.querySelectorAll("[data-photo-position-close]").forEach((button) => {
        button.addEventListener("click", close);
      });
      modal.querySelector("[data-photo-position-save]").addEventListener("click", () => {
        onSave({ x: Number(xInput.value), y: Number(yInput.value) });
        close();
      });
      modal.addEventListener("click", (event) => {
        if (event.target === modal) close();
      });

      document.body.appendChild(modal);
      apply();
      xInput.focus();
    }

    function sanitize(value) {
      const template = document.createElement("template");
      template.innerHTML = String(value || "");
      const blocked = new Set(["script", "style", "iframe", "object", "embed", "link", "meta", "base", "form", "input", "button", "textarea", "select"]);
      template.content.querySelectorAll("*").forEach((node) => {
        if (blocked.has(node.tagName.toLowerCase())) {
          node.remove();
          return;
        }
        Array.from(node.attributes).forEach((attr) => {
          const name = attr.name.toLowerCase();
          const val = String(attr.value || "").trim().toLowerCase();
          if (name.startsWith("on") || val.startsWith("javascript:")) node.removeAttribute(attr.name);
        });
      });
      return template.innerHTML;
    }

    function escapeHtml(value) {
      return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
    }

    function escapeAttr(value) {
      return escapeHtml(value).replaceAll("'", "&#39;");
    }

    function formatTime(value) {
      const date = new Date(Number(value));
      const pad = (item) => String(item).padStart(2, "0");
      if (Number.isNaN(date.getTime())) return "未知";
      return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
    }
  </script>
</body>
