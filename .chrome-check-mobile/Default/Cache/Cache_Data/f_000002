<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#fff9f5">
  <meta name="format-detection" content="telephone=no">
  <title>D&T</title>
  <style>
    :root {
      --ink: #17212b;
      --muted: #66717f;
      --paper: #fff9f5;
      --rose: #ff6f7d;
      --teal: #2bb3a3;
      --gold: #f3c455;
      --violet: #7762d1;
      --white: #ffffff;
      --shadow: 0 18px 48px rgba(23, 33, 43, 0.16);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 12% 14%, rgba(255, 159, 110, 0.24), transparent 30%),
        radial-gradient(circle at 88% 10%, rgba(43, 179, 163, 0.22), transparent 32%),
        linear-gradient(135deg, #fff9f5, #f6f9ff 52%, #fff0ed);
      overflow-x: hidden;
    }

    body::before {
      position: fixed;
      inset: 0;
      z-index: -1;
      content: "";
      background-image:
        radial-gradient(circle, rgba(255, 111, 125, 0.28) 0 2px, transparent 3px),
        radial-gradient(circle, rgba(43, 179, 163, 0.24) 0 2px, transparent 3px),
        radial-gradient(circle, rgba(119, 98, 209, 0.2) 0 2px, transparent 3px);
      background-position: 8% 20%, 82% 32%, 48% 78%;
      background-size: 180px 180px, 220px 220px, 260px 260px;
      pointer-events: none;
    }

    a { color: inherit; text-decoration: none; }
    button, input, textarea { font: inherit; }
    audio#homeMusic { display: none; }

    .screen { display: none; min-height: 100vh; }
    .screen.active { display: block; animation: enter 280ms ease both; }

    @keyframes enter {
      from { opacity: 0; transform: translateX(16px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .login-screen {
      display: none;
      min-height: 100vh;
      align-items: center;
      padding: 24px;
    }

    .login-screen.active { display: grid; }

    .login-panel {
      width: 100%;
      max-width: 440px;
      margin: auto;
      padding: 28px;
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: 8px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
    }

    .eyebrow {
      margin: 0 0 10px;
      color: var(--teal);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    h1, h2, h3, p { margin-top: 0; }

    .login-panel h1 {
      margin-bottom: 12px;
      font-size: 4.5rem;
      line-height: 0.95;
    }

    .login-panel p:not(.eyebrow) {
      color: #344454;
      line-height: 1.8;
    }

    .login-form {
      display: grid;
      gap: 12px;
      margin-top: 22px;
    }

    .login-form label,
    .settings-form label,
    .add-panel label,
    .editor label {
      display: grid;
      gap: 7px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    input, textarea {
      width: 100%;
      min-height: 48px;
      padding: 0 14px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(23, 33, 43, 0.13);
      border-radius: 8px;
      outline: none;
    }

    textarea {
      min-height: 116px;
      padding-top: 12px;
      resize: vertical;
    }

    input:focus, textarea:focus {
      border-color: var(--teal);
      box-shadow: 0 0 0 4px rgba(43, 179, 163, 0.13);
    }

    .button, .login-form button, .settings-form button, .add-panel button, .editor button, .wish-form button {
      min-height: 46px;
      padding: 0 16px;
      color: var(--white);
      background: var(--ink);
      border: 0;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 800;
    }

    .ghost-button {
      color: var(--ink) !important;
      background: rgba(23, 33, 43, 0.07) !important;
    }

    .error { min-height: 22px; margin: 0; color: var(--rose); }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: grid;
      gap: 12px;
      padding: 14px 18px;
      background: rgba(255, 249, 245, 0.86);
      border-bottom: 1px solid rgba(23, 33, 43, 0.08);
      backdrop-filter: blur(18px);
    }

    .brand {
      font-size: 1.55rem;
      font-weight: 900;
    }

    .nav {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 2px;
      color: var(--muted);
      scrollbar-width: none;
    }

    .nav::-webkit-scrollbar { display: none; }

    .nav button {
      min-height: 34px;
      padding: 0 10px;
      color: inherit;
      white-space: nowrap;
      background: rgba(23, 33, 43, 0.06);
      border: 0;
      border-radius: 8px;
      cursor: pointer;
    }

    .nav button.active {
      color: var(--white);
      background: var(--rose);
      font-weight: 800;
    }

    .nav button.edit-unlocked {
      color: var(--white);
      background: var(--teal);
      font-weight: 800;
    }

    main {
      padding: 24px 18px 36px;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
      animation: enter 280ms ease both;
    }

    .hero {
      display: grid;
      gap: 22px;
      padding: 18px 0 28px;
    }

    .hero h1 {
      margin-bottom: 18px;
      font-size: 4.6rem;
      line-height: 0.92;
    }

    .hero-copy {
      color: #344454;
      font-size: 1.08rem;
      line-height: 1.9;
    }

    .time-panel, .card, .settings-form, .wish-layout {
      background: rgba(255, 255, 255, 0.74);
      border: 1px solid rgba(255, 255, 255, 0.86);
      border-radius: 8px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
    }

    .time-panel {
      padding: 22px;
    }

    .time-panel p { margin-bottom: 6px; color: var(--muted); }
    .time-panel strong { display: block; font-size: 4.4rem; line-height: 0.92; }
    .time-panel > span { color: var(--rose); font-weight: 900; }

    .time-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 9px;
      margin-top: 20px;
    }

    .time-grid div {
      padding: 12px 6px;
      text-align: center;
      background: rgba(23, 33, 43, 0.06);
      border-radius: 8px;
    }

    .time-grid b, .time-grid small { display: block; }
    .time-grid small { margin-top: 4px; color: var(--muted); font-size: 0.74rem; }

    .section-title {
      margin: 26px 0 16px;
      font-size: 2.1rem;
      line-height: 1.1;
    }

    .grid {
      display: grid;
      gap: 14px;
    }

    .card {
      position: relative;
      min-height: 190px;
      padding: 22px;
      overflow: hidden;
    }

    .gateway-card {
      color: var(--white);
      background: linear-gradient(135deg, rgba(255, 111, 125, 0.95), rgba(119, 98, 209, 0.92));
    }

    .gateway-card:nth-child(2) { background: linear-gradient(135deg, rgba(119, 98, 209, 0.95), rgba(43, 179, 163, 0.95)); }
    .gateway-card:nth-child(3) { background: linear-gradient(135deg, rgba(255, 111, 125, 0.95), rgba(243, 196, 85, 0.92)); }
    .gateway-card:nth-child(4) { background: linear-gradient(135deg, rgba(43, 179, 163, 0.95), rgba(23, 33, 43, 0.9)); }
    .gateway-card:nth-child(5) { background: linear-gradient(135deg, rgba(43, 179, 163, 0.95), rgba(255, 159, 110, 0.95)); }
    .gateway-card:nth-child(6) { background: linear-gradient(135deg, rgba(23, 33, 43, 0.94), rgba(243, 196, 85, 0.92)); }

    .gateway-card small {
      display: block;
      margin-bottom: 42px;
      color: rgba(255, 255, 255, 0.78);
      font-weight: 900;
    }

    .gateway-card h3 { margin-bottom: 8px; font-size: 1.55rem; }
    .gateway-card p { color: rgba(255, 255, 255, 0.86); line-height: 1.7; }

    .module-edit {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 3;
      display: none;
      min-height: 30px;
      align-items: center;
      padding: 0 9px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(23, 33, 43, 0.12);
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 900;
    }

    .module-delete {
      position: absolute;
      top: 12px;
      right: 62px;
      z-index: 3;
      display: none;
      min-height: 30px;
      align-items: center;
      padding: 0 9px;
      color: var(--white);
      background: var(--rose);
      border: 1px solid rgba(23, 33, 43, 0.08);
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 900;
    }

    body.edit-unlocked .module-edit {
      display: inline-flex;
    }

    body.edit-unlocked .module-delete {
      display: inline-flex;
    }

    .module-position,
    .photo-position-button {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 3;
      display: none;
      min-height: 30px;
      align-items: center;
      padding: 0 9px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(23, 33, 43, 0.12);
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 900;
    }

    body.edit-unlocked .photo-card.has-image .module-position,
    body.edit-unlocked .photo-card.has-image .photo-position-button {
      display: inline-flex;
    }

    .edit-time {
      display: block;
      margin-top: 16px;
      color: var(--muted);
      font-size: 0.76rem;
    }

    .gateway-card .edit-time { color: rgba(255, 255, 255, 0.78); }

    .add-panel {
      display: none;
      gap: 12px;
      margin-top: 14px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.74);
      border: 1px solid rgba(255, 255, 255, 0.86);
      border-radius: 8px;
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
    }

    body.edit-unlocked .add-panel {
      display: grid;
    }

    .add-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .add-head strong {
      font-size: 1rem;
    }

    .add-message {
      min-height: 18px;
      color: var(--muted);
      font-size: 0.78rem;
      text-align: right;
    }

    .add-fields {
      display: grid;
      gap: 10px;
    }

    .add-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .custom-list {
      margin-top: 14px;
    }

    .dynamic-photo-card {
      display: block;
    }

    .photo-wall {
      display: block;
      column-count: 1;
      column-gap: 14px;
      margin-top: 14px;
    }

    .photo-card {
      position: relative;
      min-height: 270px;
      overflow: hidden;
      color: var(--white);
      background: linear-gradient(135deg, #ff9f6e, #2bb3a3);
      border-radius: 8px;
      box-shadow: var(--shadow);
    }

    .photo-card input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    .photo-card img {
      width: 100%;
      height: 270px;
      object-fit: cover;
      object-position: 50% 50%;
      opacity: 0;
    }

    .photo-card.has-image img { opacity: 1; }

    .photo-card span {
      position: absolute;
      right: 18px;
      bottom: 18px;
      left: 18px;
      font-size: 1.2rem;
      font-weight: 900;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    }

    .photo-card span b,
    .photo-card span em {
      display: block;
      font-style: normal;
    }

    .photo-card span em {
      margin-top: 6px;
      font-size: 0.88rem;
      font-weight: 500;
      line-height: 1.55;
      opacity: 0.86;
    }

    .photo-wall .photo-card {
      display: block;
      break-inside: avoid;
      min-height: 0;
      margin: 0 0 14px;
      padding: 8px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.88);
      cursor: zoom-in;
    }

    .photo-wall .photo-card:not(.has-image) {
      display: none;
      min-height: 190px;
      cursor: pointer;
      background:
        linear-gradient(135deg, rgba(255, 159, 110, 0.28), rgba(43, 179, 163, 0.24)),
        rgba(255, 255, 255, 0.88);
      border: 1px dashed rgba(23, 33, 43, 0.18);
    }

    body.edit-unlocked .photo-wall .photo-card:not(.has-image) {
      display: block;
    }

    .photo-wall .photo-card img {
      display: block;
      width: 100%;
      height: auto;
      min-height: 0;
      object-fit: contain;
      opacity: 1;
      border-radius: 6px;
    }

    .photo-wall .photo-card:not(.has-image) img {
      height: 170px;
      opacity: 0;
    }

    .photo-wall .photo-card::before {
      display: none;
    }

    .photo-wall .photo-card span {
      position: static;
      display: block;
      margin-top: 10px;
      color: var(--ink);
      font-size: 1rem;
      text-shadow: none;
    }

    .photo-wall .photo-card span em {
      color: var(--muted);
    }

    .photo-wall .edit-time {
      margin: 8px 2px 2px;
    }

    .photo-wall .module-position,
    .photo-wall .photo-position-button {
      display: none !important;
    }

    .photo-preview-modal {
      position: fixed;
      inset: 0;
      z-index: 130;
      display: grid;
      place-items: center;
      padding: 18px;
      background: rgba(23, 33, 43, 0.72);
      backdrop-filter: blur(12px);
    }

    .photo-preview-panel {
      width: min(980px, 100%);
      max-height: 92vh;
      display: grid;
      gap: 12px;
      padding: 12px;
      overflow: auto;
      color: var(--white);
    }

    .photo-preview-panel img {
      width: 100%;
      max-height: 76vh;
      object-fit: contain;
      border-radius: 8px;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
    }

    .photo-preview-caption {
      display: grid;
      gap: 5px;
      line-height: 1.7;
    }

    .photo-preview-caption strong {
      font-size: 1.15rem;
    }

    .photo-preview-caption span {
      color: rgba(255, 255, 255, 0.78);
    }

    .photo-position-modal {
      position: fixed;
      inset: 0;
      z-index: 120;
      display: grid;
      place-items: center;
      padding: 18px;
      background: rgba(23, 33, 43, 0.45);
      backdrop-filter: blur(10px);
    }

    .photo-position-panel {
      width: min(520px, 100%);
      display: grid;
      gap: 14px;
      padding: 16px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.96);
      border-radius: 8px;
      box-shadow: 0 24px 70px rgba(23, 33, 43, 0.24);
    }

    .photo-position-head,
    .photo-position-actions,
    .photo-position-range {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .photo-position-head button,
    .photo-position-actions button {
      min-height: 36px;
      padding: 0 14px;
      color: var(--ink);
      background: rgba(23, 33, 43, 0.08);
      border: 0;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 900;
    }

    .photo-position-actions button:last-child {
      color: var(--white);
      background: var(--ink);
    }

    .photo-position-preview {
      overflow: hidden;
      background: rgba(23, 33, 43, 0.08);
      border-radius: 8px;
      aspect-ratio: 16 / 10;
    }

    .photo-position-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
    }

    .photo-position-range span {
      min-width: 36px;
      color: var(--muted);
      font-size: 0.86rem;
      font-weight: 900;
    }

    .photo-position-range input {
      width: 100%;
      accent-color: var(--rose);
    }

    .wish-layout { display: grid; gap: 14px; padding: 16px; }
    .wish-form { display: none; grid-template-columns: 1fr auto; gap: 10px; }
    body.edit-unlocked .wish-form { display: grid; }
    .wish-list { display: grid; gap: 10px; padding: 0; margin: 0; list-style: none; }
    .wish-list li {
      display: grid;
      grid-template-columns: 34px 1fr 34px;
      gap: 9px;
      align-items: center;
      padding: 9px;
      background: rgba(23, 33, 43, 0.05);
      border-radius: 8px;
    }
    .wish-list button {
      width: 34px;
      height: 34px;
      border: 0;
      border-radius: 8px;
      cursor: pointer;
    }
    .wish-list .check { color: var(--white); background: var(--teal); }
    .wish-list .remove { color: var(--ink); background: rgba(23, 33, 43, 0.08); }
    body:not(.edit-unlocked) .wish-list li { grid-template-columns: 1fr; }
    body:not(.edit-unlocked) .wish-list .check,
    body:not(.edit-unlocked) .wish-list .remove { display: none; }
    .wish-list li.done .wish-text { color: var(--muted); text-decoration: line-through; }
    .wish-meta { display: block; margin-top: 3px; color: var(--muted); font-size: 0.72rem; text-decoration: none; }

    .map {
      position: relative;
      min-height: 320px;
      overflow: hidden;
      background:
        linear-gradient(135deg, rgba(255,255,255,0.9), rgba(232,249,245,0.72)),
        repeating-linear-gradient(0deg, rgba(23,33,43,0.06) 0 1px, transparent 1px 36px),
        repeating-linear-gradient(90deg, rgba(23,33,43,0.06) 0 1px, transparent 1px 36px);
      border-radius: 8px;
      box-shadow: var(--shadow);
    }

    .map::before {
      position: absolute;
      inset: 46px 32px;
      content: "";
      border: 2px dashed rgba(23,33,43,0.22);
      border-radius: 48% 52% 45% 55%;
      transform: rotate(-8deg);
    }

    .pin {
      position: absolute;
      z-index: 2;
      display: inline-flex;
      min-height: 32px;
      align-items: center;
      padding: 0 10px;
      color: var(--white);
      background: var(--rose);
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 900;
      box-shadow: 0 10px 24px rgba(23,33,43,0.18);
    }
    .pin:nth-child(1) { top: 24%; left: 17%; }
    .pin:nth-child(2) { top: 47%; right: 18%; background: var(--teal); }
    .pin:nth-child(3) { right: 32%; bottom: 20%; background: var(--violet); }

    .settings-form {
      display: grid;
      gap: 12px;
      padding: 16px;
    }

    .editor {
      position: fixed;
      right: 12px;
      bottom: 12px;
      left: 12px;
      z-index: 50;
      display: none;
      max-height: 78vh;
      overflow: auto;
      padding: 14px;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(23,33,43,0.12);
      border-radius: 8px;
      box-shadow: 0 24px 70px rgba(23, 33, 43, 0.24);
    }

    .editor.open { display: grid; gap: 12px; }

    .editor-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .editor-head strong { font-size: 1rem; }
    .editor textarea {
      font-family: Consolas, "Cascadia Mono", "Courier New", monospace;
      font-size: 0.88rem;
      line-height: 1.55;
    }
    .editor-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .hint { margin: 0; color: var(--muted); font-size: 0.82rem; line-height: 1.6; }

    @media (min-width: 760px) {
      .site-header {
        grid-template-columns: auto 1fr;
        align-items: center;
        padding: 16px 42px;
      }

      .nav { justify-content: flex-end; }
      main { padding: 40px 56px 54px; }
      .hero { grid-template-columns: 1fr 360px; align-items: center; min-height: 620px; }
      .hero h1 { font-size: 8rem; }
      .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .photo-wall {
        column-count: 3;
      }
      .settings-form { grid-template-columns: repeat(5, minmax(0, 1fr)); align-items: end; }
      .editor {
        right: 24px;
        bottom: 24px;
        left: auto;
        width: 380px;
      }
    }
  </style>
</head>
<body>
  <section class="screen login-screen active" id="loginScreen">
    <div class="login-panel">
      <p class="eyebrow">OUR ROMANTIC SPACE.</p>
      <h1>D & T</h1>
      <p>双方都不自觉紧握的东西才被叫做缘分。</p>
      <form class="login-form" id="loginForm">
        <label>
          <span>登录暗号</span>
          <input id="loginCode" type="password" inputmode="numeric" autocomplete="current-password">
        </label>
        <p class="error" id="loginError"></p>
        <button type="button" id="loginButton">进入主页</button>
      </form>
    </div>
  </section>

  <section class="screen" id="appScreen">
    <header class="site-header">
      <a class="brand" href="#home" data-go="home">D & T</a>
      <nav class="nav" id="nav">
        <button type="button" data-page="home" aria-controls="home" class="active">首页</button>
        <button type="button" data-page="story" aria-controls="story">故事</button>
        <button type="button" data-page="daily" aria-controls="daily">日常</button>
        <button type="button" data-page="notes" aria-controls="notes">碎碎念</button>
        <button type="button" data-page="travel" aria-controls="travel">旅行地图</button>
